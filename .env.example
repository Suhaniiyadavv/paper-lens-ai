# PaperLens AI Environment Variables Configuration

# GEMINI_API_KEY: Optional/Configurable for qualitative AI peer review.
# If omitted or empty, PaperLens AI runs in verified offline rule-based & heuristic mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Server listening port (default: 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
